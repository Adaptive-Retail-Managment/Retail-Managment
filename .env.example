# Copy to .env and adjust for local development.
# .env is git-ignored. Never commit real credentials.

# --- API ---
NODE_ENV=development
PORT=4000
APP_VERSION=0.1.0-foundation
# In production always include an explicit connect_timeout (seconds).
DATABASE_URL=postgresql://arp:arp_dev_password@localhost:5432/adaptive_retail?schema=public
READINESS_TIMEOUT_MS=3000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Development database (docker compose) ---
POSTGRES_USER=arp
POSTGRES_PASSWORD=arp_dev_password
POSTGRES_DB=adaptive_retail
POSTGRES_PORT=5432

# --- Web / Desktop ---
# Leave VITE_API_URL empty to use same-origin/relative URLs (Vite proxy in dev).
# VITE_API_URL=http://localhost:4000
WEB_DEV_URL=http://localhost:5173
