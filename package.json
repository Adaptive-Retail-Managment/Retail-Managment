{
  "name": "adaptive-retail-platform",
  "version": "0.1.0",
  "private": true,
  "description": "Adaptive Retail Intelligence Platform - one multi-tenant platform configured for grocery, fashion, pharmacy and cosmetics retail.",
  "license": "UNLICENSED",
  "packageManager": "pnpm@11.28.13",
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=11"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @arp/api --filter @arp/web dev",
    "dev:api": "pnpm --filter @arp/api dev",
    "dev:web": "pnpm --filter @arp/web dev",
    "dev:desktop": "pnpm --filter @arp/desktop dev",
    "build": "pnpm --filter @arp/web build && pnpm --filter @arp/desktop build && pnpm --filter @arp/api build",
    "lint": "pnpm -r --if-present lint",
    "typecheck": "pnpm -r --if-present typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm test:unit",
    "test:unit": "pnpm -r --if-present test:unit",
    "test:e2e": "pnpm --filter @arp/api test:e2e",
    "test:integration": "pnpm --filter @arp/api test:integration",
    "test:all": "pnpm test:unit && pnpm test:e2e && pnpm test:integration",
    "db:up": "docker compose -f infra/docker/compose.dev.yml up -d",
    "db:down": "docker compose -f infra/docker/compose.dev.yml down",
    "db:logs": "docker compose -f infra/docker/compose.dev.yml logs -f postgres",
    "prisma:generate": "pnpm --filter @arp/api prisma:generate",
    "prisma:validate": "pnpm --filter @arp/api prisma:validate",
    "setup": "pnpm install && pnpm prisma:generate"
  },
  "prettier": "@arp/config/prettier",
  "devDependencies": {
    "@arp/config": "workspace:*",
    "prettier": "3.10.1"
  }
}
